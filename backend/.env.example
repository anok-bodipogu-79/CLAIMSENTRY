# HealthGuard AI - Backend Environment Configuration Template

# Project & API
PROJECT_NAME="HealthGuard AI"
VERSION="1.0.0"
API_PREFIX="/api"
ENVIRONMENT="development"

# Database Configuration
# Primary Production Database: PostgreSQL (Required in production)
# Supply your own secure database credentials below:
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>"

# Note: SQLite fallback is strictly disallowed in production and only available for isolated local testing.
USE_SQLITE=False

# JWT & Authentication
# CRITICAL: Supply a strong, cryptographically generated random secret of >= 32 characters in production.
# Example generator: openssl rand -hex 32
# NOTE: Demo accounts (admin@healthguard.ai, investigator@healthguard.ai) use demo passwords that MUST be changed before non-demo deployment.
JWT_SECRET_KEY="<GENERATE_AND_INSERT_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# Machine Learning Artifacts & Thresholds
MODEL_VERSION="v2"
DEFAULT_LOW_MEDIUM_THRESHOLD=0.22
DEFAULT_MEDIUM_HIGH_THRESHOLD=0.70

# Regulatory Disclaimer
REGULATORY_DISCLAIMER="This is a risk assessment to guide investigation. It is not proof of fraud."
